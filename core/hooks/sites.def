/* Hook sites of OSOS 2.0.5, one row each. Included by sites.c (table and ids) and
 * stubs.S (per-site stubs and slots), so the two never disagree.
 *
 * SITE(name, address, kind, original, word0, word1, chain, argc, copy)
 *   address   the patched word (SITE_* from the symbols header)
 *   kind      CALL, VTABLE, ENTRY, ENTRY_NORETURN, WORD or INSERT (a call written over an
 *             ordinary instruction whose neighbours keep r0-r3 and r12 live; the stub
 *             preserves them and the handler's result is dropped)
 *   original  what an unbound site does: the callee of a CALL, the pointer in a
 *             VTABLE slot, REPLAY(name) for an ENTRY, 0 for ENTRY_NORETURN and WORD
 *   word0/1   the Apple words at the site, checked against the pinned image at build
 *             time and at install time
 *   chain     1 when Apple's semantics are understood well enough for several handlers
 *   argc      register arguments the handler receives (at most 4), plus STACK(n) for
 *             n (1 or 2) further arguments Apple passes on the stack; the handler sees
 *             them after `next`
 *   copy      0, or a register (4 to 11) the stub copies into r[argc-1] first, so a
 *             value Apple keeps in a callee-saved register at the site is an argument
 */

#define STACK(words) ((words) << 4)

/* Apple loads its preferences here; the disk is readable from this point on. */
SITE(Preferences_LoadFile_call, SITE_Preferences_LoadFile_call, CALL,
     ADDR_Preferences_LoadFile, BL(SITE_Preferences_LoadFile_call, ADDR_Preferences_LoadFile), 0,
     1, 1, 0)

/* Called once per row while Apple builds a menu's ITEM list. */
SITE(ResourceBlockList_AppendBorrowedBlock_call, SITE_ResourceBlockList_AppendBorrowedBlock_call,
     CALL, ADDR_ResourceBlockList_AppendBorrowedBlock,
     BL(SITE_ResourceBlockList_AppendBorrowedBlock_call, ADDR_ResourceBlockList_AppendBorrowedBlock),
     0, 1, 4, 0)

