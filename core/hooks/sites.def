/* The system dispatcher tells the UI the hold switch moved: (system, locked).
 * Screen controllers never see the change themselves. */
SITE(SystemUI_HandleHoldChange_call, SITE_SystemUI_HandleHoldChange_call, CALL,
     ADDR_SystemUI_HandleHoldChange,
     BL(SITE_SystemUI_HandleHoldChange_call, ADDR_SystemUI_HandleHoldChange), 0, 1, 2, 0)

/* The hold switch's logical state, read over the PMU's I2C bus on every call; no
 * arguments, 1 when locked. Input_HandleButton on the wheel task reads it for each
 * button press and release, and the system dispatcher and idle sleep on their
 * tasks; nothing reads it while core_boot runs during UI start-up unless a button
 * moves then. A replace handler answers without touching the bus. */
SITE(HoldSwitch_GetLogicalState_entry, SITE_HoldSwitch_GetLogicalState_entry, ENTRY,
     REPLAY(HoldSwitch_GetLogicalState_entry), 0xe92d4008, 0xe1a0000d, 0, 0, 0)

/* Every media list controller opens its context menu here: (controller). The
 * highlighted row is the selection's then. Only the two dispatchers on the UI
 * task call it. */
SITE(MediaListController_HandleShowContextualMenu_entry,
     SITE_MediaListController_HandleShowContextualMenu_entry, ENTRY,
     REPLAY(MediaListController_HandleShowContextualMenu_entry), 0xe92d4010, 0xe1a04000, 1, 1, 0)

/* The Cancel row of each context menu: (items, label, action, flags). A handler
 * appends its rows first, then the Cancel row through next. */
#define CANCEL_APPEND(name)                                                                      \
    SITE(name##_CancelAppend_call, SITE_##name##_CancelAppend_call, CALL,                        \
         ADDR_ContextMenuItems_Append,                                                           \
         BL(SITE_##name##_CancelAppend_call, ADDR_ContextMenuItems_Append), 0, 1, 4, 0)
CANCEL_APPEND(SongList)
CANCEL_APPEND(NestedPlaylists)
CANCEL_APPEND(Genius)
CANCEL_APPEND(NowPlaying)
CANCEL_APPEND(Artists)
CANCEL_APPEND(Albums)
#undef CANCEL_APPEND

