SITE(DiskModeExit_PopToMainScreen_call, SITE_DiskModeExit_PopToMainScreen_call, CALL,
     ADDR_Navigator_PopToMainScreen,
     BL(SITE_DiskModeExit_PopToMainScreen_call, ADDR_Navigator_PopToMainScreen), 0, 1, 0, 0)
/* Every IRQ, in IRAM: (frame) with the interrupted task's registers; returns the
 * stack to resume. Patched at boot with IRQs off; no IRQ handler runs then. */
SITE(IRQ_Dispatch_entry, SITE_IRQ_Dispatch_entry, ENTRY, REPLAY(IRQ_Dispatch_entry),
     0xe92d4010, 0xe1a04000, 1, 1, 0)
/* One run of a text view's string: (view, text, argument). The two draw calls
 * inside take stack arguments a call site cannot forward; the context
 * (view + TextView_context) holds the clip and colour once it returns. Nothing
 * is inside it while core_boot runs during UI start-up. */
SITE(TextView_DrawString_entry, SITE_TextView_DrawString_entry, ENTRY,
     REPLAY(TextView_DrawString_entry), 0xe92d40f0, 0xe1a04000, 1, 3, 0)

/* A scrolling (marquee) text view sets its colour before copying its pre-rendered
