/* EP0 vendor device-to-host requests (bmRequestType 0xC0), on USBDeviceTask:
 * (usb, &length) with the host's wLength in length; returns the data, the length
 * written back, or 0 to stall. Apple answers only bRequest 0x40. */
SITE(USB_HandleVendorDeviceRead_call, SITE_USB_HandleVendorDeviceRead_call, CALL,
     ADDR_USB_HandleVendorDeviceRead,
     BL(SITE_USB_HandleVendorDeviceRead_call, ADDR_USB_HandleVendorDeviceRead), 0, 1, 2, 0)
/* EP0 requests without a data stage, on USBDeviceTask: (usb); 0 stalls. */
SITE(USB_DispatchNoDataRequest_call, SITE_USB_DispatchNoDataRequest_call, CALL,
     ADDR_USB_DispatchNoDataRequest,
     BL(SITE_USB_DispatchNoDataRequest_call, ADDR_USB_DispatchNoDataRequest), 0, 1, 1, 0)
/* The OS disk client asked by the storage arbiter to give the volume to USB mass
 * storage: (client), with the arbiter's mutex held; 0 keeps it, and SCSI then
 * answers medium not present instead of starting disk mode. */
SITE(DiskClient_Yield_slot, SITE_DiskClient_Yield_slot, VTABLE, ADDR_DiskClient_Yield,
     ADDR_DiskClient_Yield, 0, 0, 1, 0)
/* USB disk mode has ended and the volume is readable again: App_ExitDiskMode
